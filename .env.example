# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.
# Note: any key shipped inside the mobile app bundle is extractable by anyone who
# downloads the APK. These are client-side keys — restrict/rotate them in their
# provider dashboards (Geoapify, OpenRouteService) as the real protection.

# Leftover Supabase config (no Supabase client in the app today; harmless).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Geoapify geocoding autocomplete (src/components/LocationAutocomplete.tsx)
GEOAPIFY_API_KEY=

# OpenRouteService road-distance for delivery fees
# (CartScreen + CheckoutScreen controllers). Register your OWN key at
# https://openrouteservice.org — do not reuse the public demo key.
ORS_API_KEY=

# Door Store notification backend (doorstore-backend/, deployed on Vercel).
# src/services/orderNotification.ts posts here after a buyer places an order.
#   - localhost                -> iOS simulator, or Android device via `adb reverse tcp:3000 tcp:3000`
#   - http://10.0.2.2:3000/... -> Android EMULATOR (emulator's "localhost" is itself)
#   - http://<PC-LAN-IP>:3000  -> physical phone on the same WiFi (dev only)
# After deploying to Vercel, swap in: https://<your-project>.vercel.app/api/send-notification
# NOTE: @env values are inlined at bundle time — restart Metro with `--reset-cache`
# after changing this file.
ORDER_NOTIFY_API_URL=https://doorstore-backend.vercel.app/api/send-notification

# Buyer-facing status-update endpoint (admin/shopkeeper app calls this when
# a staff member changes an order status). Backend derives title/body from
# the status: pending | on_delivery | completed | cancelled.
BUYER_NOTIFY_API_URL=https://doorstore-backend.vercel.app/api/notify-buyer

# Optional backend abuse guard: if the backend's NOTIFICATION_SECRET env var is
# set, it must match this value (sent as the `x-notification-secret` header).
# Empty here = guard disabled. Keep both sides in sync.
NOTIFICATION_SECRET=
